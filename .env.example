# Production Compose settings.
# Copy this file to .env on the VPS and adjust values there. Do not commit real secrets.

# Public host port for the Nginx frontend container.
FRONTEND_PORT=8081

# Vite build-time settings for the frontend image.
FRONTEND_BUILD_PORT=5173
BASE_PATH=/

# Leave empty in Docker Compose production so the browser calls /api on the same origin.
VITE_API_BASE_URL=

# Path on the VPS to the Basic Auth htpasswd file mounted into Nginx.
HTPASSWD_PATH=/opt/escala-generator/.htpasswd

# Backend logging.
LOG_LEVEL=info

# Private operational workbook stored on the VPS and read by the backend.
OPERATIONAL_SCHEDULE_SOURCE_PATH=/opt/escala-generator/data/Escala_em_Vigor.xlsx
